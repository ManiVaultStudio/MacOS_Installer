PROFILE_NAME=debug-simple
DEBUG_PROJECT_KEY=debug-simple

BUILD_TYPE=RelWithDebInfo
ARCHS="x86_64;arm64"
MIN_MACOS_VERSION="13.3"
CORE_BRANCH="master"
REPOSITORIES_TO_CLONE=""
UPDATE_REPOS_LIST=""
SOURCE_ROOT=""
BUILD_ROOT=""

# Leave empty to auto-generate from profile name.
INSTALL_DIR=""
OUTPUT_DIR=""
INSTALL_COPY_DIR=""
INSTALL_DMG_TEMP_DIR=""

# Per-project installer materials (shared bundle)
INSTALLER_MATERIALS_ROOT="$SCRIPTS_ROOT/../installer_materials/projects/debug-simple"
PROJECTS_SOURCE_FILE=""
APP_CONFIG_SOURCE_FILE=""
APP_ICON_FILE="$INSTALLER_MATERIALS_ROOT/appimage-manivault.icns"
DMG_BACKGROUND_IMAGE="$INSTALLER_MATERIALS_ROOT/dmg-background-manivault.png"
FOLDER_ICONS_DIR="$INSTALLER_MATERIALS_ROOT/folderIcons-manivault"
APPLY_FOLDER_ICONS="true"
LICENSE_DIR="$SCRIPTS_ROOT/../installer_materials/common/license"
ASSETS_DIR="$SCRIPTS_ROOT/../installer_materials/common/assets"

# List of plugin dylibs to exclude from the Plugins folder during DMG packaging
# Specify as space-separated names (e.g., "libExamplePlugin.dylib libTestPlugin.dylib")
# Leave empty to exclude none (default)
EXCLUDED_PLUGINS=""

APP_NAME="ManiVault Studio.app"
VOLUME_NAME="ManiVault Studio"
APP_VERSION="1.4.2"
CUSTOMIZATION_FOLDER_PRESENT="false"
MIN_CORE_VERSION_MAJOR="1"
MIN_CORE_VERSION_MINOR="4"
MIN_CORE_VERSION_PATCH="2"
MIN_CORE_VERSION_SUFFIX=""
RUN_COMMON_DEPENDENCY_BUILDS="true"
DEPENDENCY_BUILD_MODE="if-missing"

DATAPLUGIN_REPOS='{"repos":[]}'
PLUGIN_REPOS='{
  "defaultBranch":"master",
  "repos":[
    "ExtCsvLoader",
    "Scatterplot"
  ],
  "branchOverrides":{
    "ExtCsvLoader": "main"
  }
}'