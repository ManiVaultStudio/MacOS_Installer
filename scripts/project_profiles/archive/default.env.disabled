PROFILE_NAME=default

# Shared build settings
BUILD_TYPE=Release
ARCHS="x86_64;arm64"
MIN_MACOS_VERSION="12.0"
CORE_BRANCH="release/bican_bg"
REPOSITORIES_TO_CLONE=""
UPDATE_REPOS_LIST=""
SOURCE_ROOT=""
BUILD_ROOT=""

# Per-project install/output
INSTALL_DIR=""
OUTPUT_DIR=""
INSTALL_COPY_DIR=""
INSTALL_DMG_TEMP_DIR=""

# Per-project installer materials (shared bundle)
INSTALLER_MATERIALS_ROOT="$SCRIPTS_ROOT/../installer_materials/projects/default"
PROJECTS_SOURCE_FILE="$INSTALLER_MATERIALS_ROOT/projects.json"
APP_CONFIG_SOURCE_FILE="$INSTALLER_MATERIALS_ROOT/app.json"
APP_ICON_FILE="$INSTALLER_MATERIALS_ROOT/appimage-cytosplore.icns"
DMG_BACKGROUND_IMAGE="$INSTALLER_MATERIALS_ROOT/dmg-background-cytosplore.png"
FOLDER_ICONS_DIR="$INSTALLER_MATERIALS_ROOT/folderIcons-cytosplore"
LICENSE_DIR="$SCRIPTS_ROOT/../installer_materials/common/license"
ASSETS_DIR="$SCRIPTS_ROOT/../installer_materials/common/assets"

# List of plugin dylibs to exclude from the Plugins folder during DMG packaging
# Specify as space-separated names (e.g., "libExamplePlugin.dylib libTestPlugin.dylib")
# Leave empty to exclude none (default)
EXCLUDED_PLUGINS=""

# Installer metadata
APP_NAME="ManiVault Studio.app"
VOLUME_NAME="Cytosplore Viewer"
APP_VERSION="1.0.0"
CUSTOMIZATION_FOLDER_PRESENT="true"
MIN_CORE_VERSION_MAJOR="1"
MIN_CORE_VERSION_MINOR="4"
MIN_CORE_VERSION_PATCH="0"
MIN_CORE_VERSION_SUFFIX=""
RUN_COMMON_DEPENDENCY_BUILDS="true"
DEPENDENCY_BUILD_MODE="if-missing"
CORE_DISABLE_PCH_FOR_BUILD="true"
CORE_FAST_BUILD="false"

# Compact JSON: list the repos once, then use defaultBranch for the shared branch.
DATAPLUGIN_REPOS='{"defaultBranch":"release/core_bican_bg/bican_bg","repos":["XSCTreeData","XSCTreeMetaData","EphysData","CellMorphologyData"]}'
PLUGIN_REPOS='{"defaultBranch":"release/core_bican_bg/bican_bg","repos":["SparseH5DataAccessPlugin","HDF5Loader","MEView","SubsetFromSelectionPlugin","UMAP-Plugin","t-SNE-Analysis","SunburstClusterPlugin","DifferentialExpressionPlugin","DimensionPlot","ExtCsvLoader","GeneSurfer","GradientSurferPlugin","GradientSurferTransformationPlugin","LinePlotViewPlugin","PcaPlugin","ProjectAveragesPlugin","RefinePlugin","Scatterplot","ProjectionExplorer","ATACControllerPlugin","ChartLegendViewPlugin","ClusterDifferentialExpressionPlugin","SimianViewerPairExpCompPlugin","SimianViewerMultExpCompPlugin","SimianViewerPlugin","XSCPhyTVuPlugin","XSCLoaderPlugin","XSCClusterRankPlugin","XSCGeneDetectPlugin","DE-MultiSpecies","ATACViewPlugin"]}'
