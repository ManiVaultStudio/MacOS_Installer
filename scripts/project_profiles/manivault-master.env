source "$SCRIPTS_ROOT/project_profiles/common.env.sh"
DISPLAY_NAME="ManiVault Master"
PROFILE_NAME="manivault-master"
DEBUG_PROJECT_KEY=manivault-installer-main
CORE_BRANCH="master"
INSTALLER_MATERIALS_ROOT="$SCRIPTS_ROOT/../installer_materials/projects/manivault-studio-main"
PROJECTS_SOURCE_FILE=""
APP_CONFIG_SOURCE_FILE=""
APP_ICON_FILE="$INSTALLER_MATERIALS_ROOT/appimage-manivault.icns"
DMG_BACKGROUND_IMAGE="$INSTALLER_MATERIALS_ROOT/dmg-background-manivault.png"
FOLDER_ICONS_DIR="$INSTALLER_MATERIALS_ROOT/folderIcons-manivault"
EXCLUDED_PLUGINS="libExampleDataPlugin_p1.4_*.dylib"
VOLUME_NAME="ManiVault Studio"
APP_VERSION="1.5.1"
CUSTOMIZATION_FOLDER_PRESENT="false"
MIN_CORE_VERSION_MAJOR="1"
MIN_CORE_VERSION_MINOR="5"
MIN_CORE_VERSION_PATCH="1"
MIN_CORE_VERSION_SUFFIX=""
DATAPLUGIN_REPOS='{"repos":[]}'
PLUGIN_REPOS='{
  "defaultBranch":"master",
  "repos":[
    "ClusterMeansPlugin",
    "MeanShiftClustering",
    "PcaPlugin",
    "t-SNE-Analysis",
    "UMAP-Plugin",
    "ExamplePlugins",
    "BinIO",
    "CsvWriter",
    "ClusterIO",
    "ENVILoader",
    "ExtCsvLoader",
    "HDF5Loader",
    "ImageLoaderPlugin",
    "JupyterPlugin",
    "ImageTransformationPlugin",
    "PointDataConversionPlugin",
    "DimensionsViewerPlugin",
    "Heatmap",
    "ImageViewerPlugin",
    "ParallelCoordinatesPlugin",
    "Scatterplot",
    "SpectralViewPlugin"
  ],
  "branchOverrides":{
    "JupyterPlugin":"main",
    "ClusterMeansPlugin": "main",
    "PcaPlugin": "main",
    "UMAP-Plugin": "main",
    "CsvWriter": "main",
    "ClusterIO": "main",
    "ENVILoader": "main",
    "ExtCsvLoader": "main",
    "ImageTransformationPlugin": "main",
    "PointDataConversionPlugin": "main",
    "SpectralViewPlugin": "main",
    "Scatterplot": "master"
  }
}'
